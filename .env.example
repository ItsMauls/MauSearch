# --- AI: any OpenAI-compatible router ---------------------------------------
# 9router and OpenRouter speak the same protocol, so switching is a base URL
# change and nothing else. Without a key the app runs on committed fixtures,
# so you can clone and run it with zero credentials.
#
#   OpenRouter   https://openrouter.ai/api/v1
#   9router      https://api.9router.com/v1
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3.5-lightning:free
# Optional cheaper route for the low-temperature intent stage.
AI_MODEL_FAST=
# Sent as the OpenRouter attribution header; ignored by other routers.
AI_SITE_URL=

# --- App: where this deployment answers its own requests ---------------------
# A desk can take minutes, so the pipeline runs as a relay of background
# workers, each handing the next desk to a fresh invocation through this URL.
# Only set it when the guess is wrong: Vercel is detected automatically, and
# anything else falls back to http://127.0.0.1:$PORT.
APP_URL=

# --- Storage: Neon Postgres --------------------------------------------------
# Required in production. Omit locally and runs are kept in memory for the life
# of the process (single-process only - fine for review, not for serverless).
DATABASE_URL=
