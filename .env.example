# --- AI: 9router (OpenAI-compatible) ----------------------------------------
# Without a key the app runs on committed fixtures, so you can clone and run it
# with zero credentials. Google Suggest harvesting stays live either way.
NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=https://api.9router.com/v1
MAUSEARCH_MODEL=nvidia/nemotron-nano-9b-v2
# Optional cheaper route for the low-temperature intent stage.
MAUSEARCH_MODEL_FAST=

# --- Storage: Neon Postgres --------------------------------------------------
# Omit for local review and runs are kept in memory for the life of the process.
DATABASE_URL=
